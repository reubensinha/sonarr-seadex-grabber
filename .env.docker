# Environment variables for Docker Compose
# Copy this file to .env and fill in your actual values

# ---- Standalone (docker-compose.yml) ----
# If you're using docker-compose.full.yml instead (bundled Sonarr +
# qBittorrent), you can leave SONARR_URL/QB_URL unset - that file defaults
# them to the bundled containers' internal service names.

# Sonarr Configuration (required for docker-compose.yml)
SONARR_URL=http://your-sonarr-host:8989
SONARR_API_KEY=your-sonarr-api-key-here
SONARR_SERIES_TYPE=  # Optional: Type of series to monitor (e.g., "anime", "standard")
SONARR_TAGS=  # Optional: Comma-separated list of tags to filter series (e.g., "anime,imported")

# qBittorrent Configuration (required for docker-compose.yml)
QB_URL=http://your-qbittorrent-host:8080
QB_USER=your-qbittorrent-username
QB_PASS=your-qbittorrent-password
QB_CATEGORY=anime-sonarr  # qBittorrent category for downloads

# General settings
USE_WEBHOOK=false  # Set to true to enable webhook server
STARTUP_SCAN=false  # Populate the cache on first launch without sending anything to qBittorrent
SYNC_INTERVAL=86400  # Seconds between scheduled syncs (also settable/lockable via the Settings page - see ReadMe.md)

# ---- Full stack only (docker-compose.full.yml) ----

# Media and Downloads Paths
MEDIA_PATH=/path/to/your/media
DOWNLOADS_PATH=/path/to/your/downloads

# Optional: Timezone
TZ=UTC

# Optional: User/Group IDs (for Linux hosts)
PUID=1000
PGID=1000
