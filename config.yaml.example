# Configuration for Sonarr and external metadata services
#
# This file is entirely optional - every setting below can also be set via
# an environment variable (see the comment above each section), and
# core/config.py works fine even if this file doesn't exist at all. For a
# Docker deployment, just fill in .env (copy from .env.docker) and you're
# done; this file is only useful for local/bare-metal runs or for tuning
# scoring.tracker_weights, which has no environment variable equivalent.

# General settings
general:
  startup_scan: false # Whether to perform a scan on startup. Set via STARTUP_SCAN environment variable

# Data directory for persistent cache
data:
  dir: "data" # Set via DATA_DIR environment variable
  known_series_file: "known_series.json" # Set via KNOWN_SERIES_FILE environment variable
  settings_file: "settings.json" # Holds UI-adjustable runtime overrides (e.g. sync_interval). Set via SETTINGS_FILE environment variable

# Scheduling (in seconds) - also adjustable at runtime from the WebUI's
# Settings page, unless the SYNC_INTERVAL environment variable is set, in
# which case it's locked to that value and can't be changed from the UI.
scheduling:
  sync_interval: 86400 # 24 hours in seconds. Set via SYNC_INTERVAL environment variable

# Sonarr configuration
# Use environment variables: SONARR_URL, SONARR_API_KEY, SONARR_SERIES_TYPE, SONARR_TAGS
sonarr:
  url: "" # Set via SONARR_URL environment variable
  api_key: "" # Set via SONARR_API_KEY environment variable
  series_type: "" # Set via SONARR_SERIES_TYPE environment variable (optional)
  tags: [] # Set via SONARR_TAGS environment variable (comma-separated list)

# AniList configuration
anilist:
  api_url: "https://graphql.anilist.co" # Set via ANILIST_API_URL environment variable

# Seadex configuration
seadex:
  collections_url: "https://releases.moe/api/collections/entries/records" # Set via COLLECTIONS_URL environment variable
  torrent_url: "https://releases.moe/api/collections/torrents/records" # Set via TORRENT_URL environment variable

# Torrent scoring configuration
scoring:
  is_best_weight: 2 # Points for torrents marked as "best". Set via SCORING_IS_BEST_WEIGHT environment variable
  dual_audio_weight: 1 # Points for dual audio torrents. Set via SCORING_DUAL_AUDIO_WEIGHT environment variable
  tracker_weights: # Points per tracker (can be negative for penalties) - config.yaml only, no environment variable equivalent
    "Nyaa": 0 # Nyaa is the baseline (0 points)
    "AB": -10
    "default": 0 # Default penalty for unknown trackers

# qBittorrent configuration
# Use environment variables: QB_URL, QB_USER, QB_PASS, QB_CATEGORY
qbittorrent:
  url: "" # Set via QB_URL environment variable
  username: "" # Set via QB_USER environment variable
  password: "" # Set via QB_PASS environment variable
  category: "anime-sonarr" # Set via QB_CATEGORY environment variable

# Webhook Server configuration
# Use environment variables: WEBHOOK_HOST, WEBHOOK_PORT, USE_WEBHOOK
webhook:
  host: "localhost" # Set via WEBHOOK_HOST environment variable
  port: 8765 # Set via WEBHOOK_PORT environment variable
  enabled: false # Set via USE_WEBHOOK environment variable
